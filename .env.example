# Copy outside the checkout and pass it with --env-file for intake or autopilot.
# Never place a real credential in a committed file or task JSON.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
# Optional variables for the lower-level `run` command; study protocols name their model.
RSI_MODEL=
RSI_API_KEY=
# Optional custom provider endpoint (no URL credentials or query parameters).
RSI_API_BASE=
